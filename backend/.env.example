# Backend environment variables (copy this file to backend/.env)
# backend/.env is gitignored. Never commit real values or put them in a zip.

# Separate PostgreSQL application database (NOT Supabase Postgres)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/recuirement_agent

# Supabase project settings (authentication only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Portkey AI gateway used by the RAG agents
PORTKEY_AI_API=
PORTKEY_SLUGS=

# Local Ollama used only for candidate match scoring (no Portkey fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Keep the KV cache small enough to stay fully on the GPU. Ollama's default of
# the model's maximum context (131072) forces CPU offload and is ~10x slower.
# OLLAMA_NUM_CTX=8192
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_TIMEOUT=120

# Web job search: JSearch (RapidAPI) is primary, Tavily is the fallback.
# JSEARCH_API_KEY=CHANGE_ME
# RAPIDAPI_KEY=CHANGE_ME   # alternative name for the same RapidAPI key
# TAVILY_API_KEY=CHANGE_ME
# Set to false to skip the per-result LLM single-posting check (faster, less strict)
# JOB_SEARCH_LLM_VALIDATION=true

# Frontend development origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# Gmail SMTP (optional: enables email copies of interview reminders).
# Use a Gmail App Password, NOT your account password, and never commit real values.
# SMTP_EMAIL=your-address@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# Optional delivery tuning (defaults shown)
# EMAIL_CLAIM_TIMEOUT_MINUTES=5
# EMAIL_RETRY_DELAY_MINUTES=15

# Reminder dispatcher (defaults shown). Keep one dispatcher process running;
# set REMINDER_SCHEDULER_ENABLED=false on additional workers (DB locks already
# prevent duplicate sends even if several poll).
# REMINDER_POLL_SECONDS=60
# REMINDER_SCHEDULER_ENABLED=true

# Optional overrides (defaults are fine for local development):
# CHAT_RATE_LIMIT_MAX_REQUESTS=
# CHAT_RATE_LIMIT_WINDOW_SECONDS=
# RAG_CACHE_TTL_SECONDS=
# RAG_CACHE_MAX_ENTRIES=
# RAG_ALLOW_MODEL_DOWNLOAD=
# METRICS_SLOW_REQUEST_MS=
